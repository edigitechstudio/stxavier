# Copy to .env.local and fill in. Never commit real values.

# --- Site ---------------------------------------------------------------------
# Public origin used for canonical URLs, sitemap, schema and OG tags.
NEXT_PUBLIC_SITE_URL=https://stxavier.com.np

# --- Supabase (content, leads, bookings, portal) ------------------------------
# Leave blank to run on the seed content in data/seed (read-only, no forms stored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by API routes and `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=
# Auth redirect URL to allow in Supabase: <site>/api/auth/callback (see docs/CONTENT-EDITING.md).
# Without Supabase keys, `npm run dev` runs the portal/admin in an in-memory demo mode.

# Shared secret for /api/revalidate (Supabase DB webhooks + admin dashboard).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# --- Spam protection & rate limiting -----------------------------------------
# Cloudflare Turnstile (free). Without keys the widget is skipped and the server accepts
# submissions (a warning is logged in production) — set both before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis (free tier is fine). Without it, a per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Phase 5) ------------------------------------------------------------
# Resend: verify stxavier.com.np in Resend first. Without a key emails are only logged.
# LEADS_NOTIFY_EMAIL may be a comma-separated list (staff alerts for leads & bookings).
RESEND_API_KEY=
EMAIL_FROM="St. Xavier Educational Network <noreply@stxavier.com.np>"
LEADS_NOTIFY_EMAIL=info@stxavier.com.np

# --- Analytics (loaded only after cookie consent) -----------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Reviews widget (Phase 4) ---------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Exchange rates for the cost calculator (Phase 3) -------------------------
EXCHANGE_RATE_API_URL=

# --- AI chat assistant (Phase 7) ----------------------------------------------
# The assistant answers only from the site's own content (FAQ, destinations, services…).
# Without a provider key it still works in "basic" mode: it quotes the best-matching passage.
#   anthropic → Claude via the official SDK (ANTHROPIC_API_KEY)
#   openai    → any OpenAI-compatible API (OPENAI_API_KEY + AI_MODEL, optional OPENAI_BASE_URL)
#   none      → basic mode only
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default claude-opus-5-5 (best answers). For a much cheaper high-traffic widget use claude-haiku-5-5.
AI_MODEL=
# low (default, fast & cheap for chat) | medium | high
AI_EFFORT=low
# Includes the model's internal reasoning; 4000 leaves room for a short answer.
AI_MAX_OUTPUT_TOKENS=4000
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Signs chat sessions after the first Turnstile check. Falls back to REVALIDATE_SECRET.
CHAT_SESSION_SECRET=
